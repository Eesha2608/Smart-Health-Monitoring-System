}
function renderStreak(){
  const j=getJ(),days=new Set(j.map(e=>dayKey(e.t))),box=$('#days');box.innerHTML='';
  let wk=0;const names=['Su','Mo','Tu','We','Th','Fr','Sa'];
  for(let i=6;i>=0;i--){
    const d=new Date(Date.now()-i*864e5),on=days.has(dayKey(d));if(on)wk++;
    const el=document.createElement('i');el.textContent=names[d.getDay()];if(on)el.className='on';
    el.setAttribute('aria-label',d.toLocaleDateString(undefined,{weekday:'long'})+(on?': measured':': not measured'));box.appendChild(el);
  }
  let s=0;const t=new Date();if(!days.has(dayKey(t)))t.setDate(t.getDate()-1);
  while(days.has(dayKey(t))){s++;t.setDate(t.getDate()-1)}
  $('#streak-note').textContent=wk+' of 7 days measured this week. '+(s>1?'Current streak: '+s+' days. ':'')+(wk>=5?'Goal reached: five days a week.':'Goal: measure on five days a week for a clear trend.');
}
function renderInsights(){
  const j=getJ(),out=[];
  const ms=[['rmssd','HRV','ms',true],['hr','resting heart rate','bpm',false],['ready','readiness','',true]];
  j.forEach(e=>{e._t=(e.tags||[]).concat(e.sleep?['Sleep: '+e.sleep]:[])});
  const tags=new Set();j.forEach(e=>e._t.forEach(t=>tags.add(t)));
  tags.forEach(tag=>{
    const w=j.filter(e=>e._t.includes(tag)),wo=j.filter(e=>!e._t.includes(tag));
    if(w.length<3||wo.length<3)return;
    ms.forEach(([k,l,u,hi])=>{
      const a=w.map(e=>e[k]).filter(x=>x!=null),b=wo.map(e=>e[k]).filter(x=>x!=null);
      if(a.length<3||b.length<3)return;
      const d=mean(a)-mean(b),rel=Math.abs(d)/Math.max(1,mean(b));
      if(rel<0.08)return;
      out.push({rel,t:'On readings tagged \u201C'+tag+'\u201D your '+l+' averaged '+Math.round(Math.abs(d))+(u?' '+u:'')+(d>0?' higher':' lower')+' ('+a.length+' vs '+b.length+' readings).'});
    });
  });
  out.sort((a,b)=>b.rel-a.rel);
  const card=$('#insightCard');card.hidden=!out.length;
  $('#insights').innerHTML=out.slice(0,4).map(o=>'<li>'+esc(o.t)+'</li>').join('');
}

 ["Aim for 150 minutes a week of moderate activity as health allows.","Check with a doctor if you have heart disease, dizziness or joint problems."],['eldercare','strength','steps']);
E('heartathletes',"Is my heart safe for intense exercise?",['sudden cardiac','athlete heart','collapse while running','heart safe exercise','gym heart attack','chest pain exercise','young heart attack','heart screening athletes','pre participation'],

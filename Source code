function endRecovery(){
  calm.running=false;calm.rec=false;cancelAnimationFrame(calm.raf);
  const h=calm.hr,first=h.filter(x=>x.t<25000),at60=h.filter(x=>x.t>=50000&&x.t<=75000);
  let txt;
  if(first.length<3||at60.length<3)txt='I did not get enough heart-rate readings. Connect the sensor and rest your finger on it right after you sit down, then try again.';
  else{
    const peak=Math.round(Math.max(...first.map(x=>x.hr))),low=Math.round(mean(at60.map(x=>x.hr))),d=peak-low;
    const v=d>=25?'excellent':d>=18?'good':d>=12?'average':'slow';
    txt='Your heart rate fell from '+peak+' to '+low+' beats per minute in about a minute, a drop of '+d+'. That is '+v+' recovery. Drops above 12 are generally seen as healthy. Repeat this test every few weeks to track your fitness.';
    const rl=store.get('pulsespace.recovery.v1')||[];rl.push({t:new Date().toISOString(),d});store.set('pulsespace.recovery.v1',rl.slice(-30));
    if(rl.length>1)txt+=' Your previous drop was '+rl[rl.length-2].d+'.';
  }
  $('#calm-sum').textContent=txt;calmPanel('done');
}
const easeIO=x=>x<.5?2*x*x:1-Math.pow(-2*x+2,2)/2;
function calmTick(now){
  if(!calm.open||!calm.running)return;
  const el=(now-calm.t0)/1000,total=calm.min*60;
  if(el>=total){endCalm(true);return}
  const steps=PATTERNS[calm.pat].steps,cycle=steps.reduce((s,x)=>s+x[1],0);
  let t=el%cycle,i=0;while(t>=steps[i][1]){t-=steps[i][1];i++}
  const kind=steps[i][0],dur=steps[i][1],f=t/dur;
  let s;
  if(kind==='in')s=.55+.45*easeIO(f);
  else if(kind==='out')s=1-.45*easeIO(f);
  else s=steps[(i+steps.length-1)%steps.length][0]==='in'?1:.55;
  $('#calm-i').style.transform='scale('+s.toFixed(3)+')';
  const label=kind==='in'?'Breathe in':kind==='out'?'Breathe out':'Hold';
  if(label!==calm.lastPhase){calm.lastPhase=label;$('#calm-phase').textContent=label;chime(kind)}
  const rem=Math.ceil(total-el);$('#calm-time').textContent=Math.floor(rem/60)+':'+String(rem%60).padStart(2,'0');
  calm.raf=requestAnimationFrame(calmTick);
}
function endCalm(done){
  calm.running=false;cancelAnimationFrame(calm.raf);
  const el=Math.round((performance.now()-calm.t0)/1000),mins=Math.max(1,Math.round(el/60));
  const total=el*1000,a=calm.hr.filter(x=>x.t<Math.min(60000,total/3)),b=calm.hr.filter(x=>x.t>total-Math.min(60000,total/3));
  let txt=done?'You breathed with the circle for '+calm.min+' minute'+(calm.min===1?'':'s')+'. ':'You breathed with the circle for about '+mins+' minute'+(mins===1?'':'s')+'. ';
  if(a.length>=2&&b.length>=2){const x=Math.round(mean(a.map(v=>v.hr))),y=Math.round(mean(b.map(v=>v.hr)));txt+='Your heart rate went from '+x+' to '+y+' beats per minute.'}
  else txt+='Measure again to see how your numbers changed.';
  $('#calm-sum').textContent=txt;calmPanel('done');
  setTimeout(()=>{const b2=$('#calm-measure');if(b2)b2.focus()},30);
}


/* ---------- teach the coach, and remember what it could not answer ---------- */
const TKEY='pulsespace.taught.v1',MKEY='pulsespace.missed.v1';
const getT=()=>{const v=store.get(TKEY);return Array.isArray(v)?v:[]};
const getM=()=>{const v=store.get(MKEY);return Array.isArray(v)?v:[]};
function sim(a,b){
  const A=new Set(words(a)),B=new Set(words(b));if(!A.size||!B.size)return 0;
  let i=0;A.forEach(w=>{if(B.has(w))i++});return i/(A.size+B.size-i);
}
function taughtMatch(q){
  let best=null,bs=0;getT().forEach(e=>{const s=sim(q,e.q);if(s>bs){bs=s;best=e}});
  return bs>=0.6?best:null;
}
function coachCommand(q){
  let m;
  if(m=q.match(/^teach\s*:\s*(.+?)\s*(?:=>|=|->)\s*(.+)$/i)){
    const qq=m[1].trim().slice(0,200),aa=m[2].trim().slice(0,800);
    if(qq.length<3||aa.length<3)return {paras:["Use this form: teach: your question => your answer"]};
    const t=getT().filter(e=>sim(e.q,qq)<0.9);t.push({q:qq,a:aa});store.set(TKEY,t.slice(-200));
    return {paras:["Learned. Next time you ask \u201C"+qq+"\u201D I will answer with what you taught me."],chips:["Show what you have learned"]};
  }
  if(/^(show|list) (what you have learned|taught|what i taught|learned)/i.test(q)||/^show what you have learned$/i.test(q)){
    const t=getT();
    return t.length?{paras:["You have taught me "+t.length+" thing"+(t.length===1?"":"s")+":"],bullets:t.map(e=>e.q+" \u2192 "+e.a),chips:["Forget what I taught"]}:{paras:["Nothing yet. Teach me with:  teach: your question => your answer"]};
  }
  if(/^forget (what i taught|taught|everything i taught)/i.test(q)){store.set(TKEY,[]);return {paras:["Done. I forgot everything you taught me."]}}
  if(/^(missed|unanswered) questions|what did you miss|show missed/i.test(q)){
    const m2=getM();
    return m2.length?{paras:["Questions I could not answer ("+m2.length+"). Send these to whoever maintains PulseSpace so they can be added, or teach me the answers:"],bullets:m2.slice(-20),chips:["Clear missed questions"]}:{paras:["I have no unanswered questions saved."]};
  }
  if(/^clear missed/i.test(q)){store.set(MKEY,[]);return {paras:["Cleared."]}}
  return null;
}

/* ---------- coach ---------- */
const chat={greeted:false,summaryFor:null,last:null};
const chatLog=()=>$('#chat-log');
function clearFollow(){chatLog().querySelectorAll('.follow').forEach(n=>n.remove())}
function scrollChat(){const l=chatLog();l.scrollTop=l.scrollHeight}
function botMsg(a){
  clearFollow();
  const el=document.createElement('div');el.className='msg bot';
  (a.paras||[]).forEach(t=>{const p=document.createElement('p');p.textContent=t;el.appendChild(p)});
  if(a.bullets&&a.bullets.length){const ul=document.createElement('ul');a.bullets.forEach(t=>{const li=document.createElement('li');li.textContent=t;ul.appendChild(li)});el.appendChild(ul)}
  if(a.after){const p=document.createElement('p');p.textContent=a.after;el.appendChild(p)}
  if(a.widget==='breath')el.appendChild(breathWidget());
  chatLog().appendChild(el);
  if(a.chips&&a.chips.length){
    const f=document.createElement('div');f.className='follow';
    a.chips.forEach(c=>{const b=document.createElement('button');b.type='button';b.className='fu';b.textContent=c;b.addEventListener('click',()=>ask(c));f.appendChild(b)});
    chatLog().appendChild(f);
  }
  scrollChat();
}
function ask(q){
  q=q.trim();if(!q)return;
  clearFollow();
  const u=document.createElement('div');u.className='msg me';u.textContent=q;chatLog().appendChild(u);
  const t=document.createElement('div');t.className='msg bot typing';t.innerHTML='<i></i><i></i><i></i>';chatLog().appendChild(t);
  scrollChat();
  setTimeout(()=>{
    t.remove();
    if(/^(open|show|go to) (my )?journal$/i.test(q)){goStep(4);closeCoach();return}
    if(/^(start|begin|open) (a )?calm( session)?$/i.test(q)){closeCoach();openCalm();return}
    const cmd=coachCommand(q);if(cmd){botMsg(cmd);return}
    const a=answer(q),tm=taughtMatch(q);
    if(tm&&!a.safety){botMsg({paras:[tm.a],after:'You taught me this answer.',chips:[]});return}
    if(a.miss){const m2=getM();if(!m2.includes(q)){m2.push(q.slice(0,200));store.set(MKEY,m2.slice(-100))}}
    botMsg(a);
  },400+Math.random()*300);
}
function openCoach(){
  $('#coach').classList.add('open');$('#scrim').hidden=false;
  const fab=$('#coach-fab');fab.hidden=true;fab.classList.remove('has-new');
  if(!chat.greeted){
    chat.greeted=true;
    botMsg({paras:["Hi, I am the PulseSpace Coach. Type any health question below, or tap a suggestion. I can explain your readings, answer questions on heart health, habits, symptoms and first aid, read back your journal, and do quick calculations.","I run inside this page, so I am free and private. You can also teach me: type  teach: question => answer  and I will remember it on this device. I am not a doctor."],chips:HOME_CHIPS});
  }
  if(result&&chat.summaryFor!==result){chat.summaryFor=result;botMsg(summaryAnswer(result))}
  setTimeout(()=>$('#chat-input').focus(),300);
}
function closeCoach(){
  $('#coach').classList.remove('open');$('#scrim').hidden=true;$('#coach-fab').hidden=false;
}
function sendChat(){const i=$('#chat-input');const v=i.value;if(!v.trim())return;i.value='';ask(v);i.focus()}

/* ---------- navigation ---------- */
function goStep(n){
  if(n===1){renderQ();show('intake')}
  else if(n===2){
    if(serial.port&&serial.mode==='measure'){show('measure');if(lastReadout)renderReadout(lastReadout[0],lastReadout[1])}
    else idleMeasure();
  }
  else if(n===3){show('results');if(result)renderResults();else renderPreview()}
  else{show("journal");renderJournal()}
}


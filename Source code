E('psoriasis',"What is psoriasis?",['psoriasis','silvery scales','thick red patches','scalp psoriasis','plaque','skin plaques'],
 ["Psoriasis causes thick red patches with silvery scales. It is an immune condition, not contagious, and it comes and goes."],
 ["Moisturise, avoid smoking and alcohol and manage stress.","A dermatologist can prescribe creams, light therapy or tablets."],['eczema']);
E('fungal',"How do I treat a fungal skin infection?",['fungal infection','ringworm','tinea','athletes foot','jock itch','nail fungus','itchy groin','itching between toes','dhobi itch','ring shaped rash','skin fungus','white patches skin','vitiligo'],
 ["Keep the area clean and dry and use an antifungal cream as directed, continuing for 1 to 2 weeks after it clears."],
 ["Wash towels and clothes in hot water, and do not share them.","Wear loose cotton and dry thoroughly after bathing.","Nail infections and widespread rashes need a doctor."],['skin','monsoon']);
E('scabies',"What are lice, scabies or bed bugs?",['scabies','lice','head lice','nits','bed bugs','itching at night','mites','itchy rash fingers'],

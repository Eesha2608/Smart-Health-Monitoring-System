    const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='pulsespace-backup.json';document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(a.href),1500);jmsg('Backup downloaded.')}catch(e){jmsg('Backup is blocked in this view. Open the downloaded PulseSpace file in Chrome or Edge.')}

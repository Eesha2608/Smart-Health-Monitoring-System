function journalIntent(q){
  if(!/\b(my|the) (average|averages|trend|trends|history|journal|saved readings?|last readings?|last measurement|previous readings?|progress)\b|how have i been|this week|last week|compare (my|with|to)|since last time|\bjournal\b/.test(q))return null;
  if(/\b(how|where) (do|to|can) i\b|what is (a|the) journal|\bdelete\b|\bexport\b|\bcsv\b/.test(q))return null;
  const st=journalStats();
  if(!st)return {paras:["You have not saved any readings yet. After a measurement, press Save to journal, and I can summarise your week and your trends."],chips:["How do I save my readings?","What can you answer?"]};
  const w=st.week,l=st.last,line=(lab,v,u)=>v==null?null:lab+": "+v+(u?" "+u:"");
  const bullets=[line("Heart rate",w.hr,"bpm"),line("HRV",w.rmssd,"ms"),line("SpO₂",w.spo2,"%"),line("Stress score",w.stress,""),line("Readiness",w.ready,"")].filter(Boolean);
  const paras=["You have "+st.n+" saved reading"+(st.n===1?"":"s")+"."];
  let after;
  if(w.n){paras.push("In the last 7 days you saved "+w.n+". Your averages:")}
  else{paras.push("Nothing was saved in the last 7 days. Here are your all-time averages:");bullets.length=0;[line("Heart rate",st.all.hr,"bpm"),line("HRV",st.all.rmssd,"ms"),line("SpO₂",st.all.spo2,"%"),line("Stress score",st.all.stress,"")].filter(Boolean).forEach(x=>bullets.push(x))}
  if(l&&st.all.hr!=null&&l.hr!=null){const d=l.hr-st.all.hr;after="Your latest saved heart rate was "+l.hr+" bpm, "+(d===0?"the same as":Math.abs(d)+" bpm "+(d<0?"lower than":"higher than"))+" your usual."}
  return {paras,bullets,after,chips:["Open my journal","Should I see a doctor?"]};
}



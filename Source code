  if(/^(who|what) (are|r) (you|u)\b|who (made|built|created) you|your name|are you (a |an )?(ai|bot|robot|human|real)/.test(q))return kbAnswer(KBMAP.smalltalk1,d);
  const jr=journalIntent(q);if(jr){jr.local=true;return jr}
  const calc=calcAnswer(raw)||readingAnswer(raw);
  if(calc){calc.local=true;return calc}
  const rank=kbRank(q),top=rank[0];
  if(top&&top.score>=6)return kbAnswer(top.e,d);
  if(/summary|summari|my (readings|results|numbers)|how am i|overall|latest|explain (my )?(results|readings)/.test(q))return Object.assign(summaryAnswer(d),{local:true});
  if(/doctor|hospital|worr|serious|danger|should i (see|go)|is (this|it) (bad|ok|okay|normal)|am i (ok|okay|fine|healthy)/.test(q))return Object.assign(doctorAnswer(d),{local:true});
  if(top&&top.score>=2)return kbAnswer(top.e,d);
  if(/(how|what).*(lower|reduce|improve|raise|increase|boost|fix|bring down|better)|tips|advice|suggest/.test(q))return improveAnswer(t||(d?weakest(d):'general'));
  if(/normal|range|healthy range|good (level|value|number)/.test(q))return RANGES;
  if(/how.*(work|calculat|comput)|algorithm/.test(q))return HOW;
  if(/connect|arduino|usb|port|no data|not working|start measuring|take (a )?(reading|measurement)|measure again/.test(q))return CONNECT;
  if(/breath|calm|relax|panic|meditat/.test(q))return BREATHING;
  if(/sleep|caffeine|coffee|water|hydrat|diet|exercise|workout|walk|alcohol/.test(q))return LIFESTYLE;
  if(t)return explainAnswer(t,d);
  const near3=rank.filter(r=>r.score>0).slice(0,3);
  if(near3.length)return {miss:true,paras:["I am not sure I understood. Did you mean one of these?"],chips:near3.map(r=>r.e.q)};
  return {miss:true,paras:["I do not have a written answer for that. I have saved your question so it can be added later. You can also teach me: type  teach: your question => your answer  and I will remember it on this device. For health concerns, please ask a doctor or pharmacist."],chips:["What can you answer?","Explain my readings"]};
}



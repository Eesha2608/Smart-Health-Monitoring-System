/* ---------- sensor over USB serial ---------- */
const serial={port:null,reader:null,closed:null,mode:'measure'};
function sensorNote(mode,msg){if(mode==='calm')calmMsg(msg);else note(msg)}
function handleLine(s){
  if(!s)return;const p=s.split(','),t=p[0];
  if(t==='W'){const v=parseFloat(p[1]);if(!isNaN(v))pushWave(v)}
  else if(t==='B'){onBeat(parseFloat(p[1]))}
  else if(t==='PS'){
    const n=p.slice(1).map(parseFloat);
    if(n.length>=6&&n.every(x=>!isNaN(x)))onSummary({hr:n[0],spo2:n[1],pi:n[2],sq:n[3],amp:n[4],temp:n[5]});
  }
  else if(t==='ERR'){sensorNote(serial.mode,'Sensor says: '+p.slice(1).join(','))}
}
async function connectSerial(mode){
  mode=mode||'measure';
  if(!('serial' in navigator)){
    sensorNote(mode,'USB serial is not available here. Open the PulseSpace file in Chrome or Edge on a computer, then press Connect sensor.');
    return;
  }
  let port;
  try{port=await navigator.serial.requestPort()}
  catch(e){
    if(e&&e.name==='NotFoundError')return;
    sensorNote(mode,'The browser blocked USB access in this view. Open the PulseSpace file directly in Chrome or Edge, then press Connect sensor.');
    return;
  }
  try{
    await port.open({baudRate:115200});
    serial.port=port;serial.mode=mode;note('');
    if(mode==='measure')startMeasure();else calmSensor(true);
    const dec=new TextDecoderStream();
    serial.closed=port.readable.pipeTo(dec.writable).catch(()=>{});
    serial.reader=dec.readable.getReader();
    let buf='';
    for(;;){
      const r=await serial.reader.read();
      if(r.done)break;
      buf+=r.value;let i;
      while((i=buf.indexOf('\n'))>=0){handleLine(buf.slice(0,i).trim());buf=buf.slice(i+1)}
    }
  }catch(e){
    sensorNote(mode,'Could not read from that port. Close the Arduino Serial Monitor and try again.');
  }finally{
    try{if(serial.reader)await serial.reader.cancel()}catch(e){}
    try{if(serial.closed)await serial.closed}catch(e){}
    try{if(serial.port)await serial.port.close()}catch(e){}
    serial.port=serial.reader=serial.closed=null;
    if(mode==='measure'){if(view==='measure'){const msg=$('#note2').hidden?'':$('#note2').textContent;idleMeasure();if(msg)note(msg)}}
    else calmSensor(false);
  }
}
function disconnectSerial(){if(serial.reader)serial.reader.cancel().catch(()=>{})}


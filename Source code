/* ---------- pulse waveform ribbon ---------- */
const cv=$('#wave');
function drawWave(){
  const w=cv.clientWidth,h=cv.clientHeight;if(!w||!h)return;
  const dpr=window.devicePixelRatio||1;
  if(cv.width!==Math.round(w*dpr)||cv.height!==Math.round(h*dpr)){cv.width=Math.round(w*dpr);cv.height=Math.round(h*dpr)}
  const ctx=cv.getContext('2d');ctx.setTransform(dpr,0,0,dpr,0,0);ctx.clearRect(0,0,w,h);
  const cs=getComputedStyle(document.documentElement);
  const line=cs.getPropertyValue('--line').trim()||'#555',pulse=cs.getPropertyValue('--pulse').trim()||'#f55';
  ctx.strokeStyle=line;ctx.globalAlpha=.55;ctx.lineWidth=1;ctx.beginPath();
  for(let i=1;i<12;i++){const x=Math.round(w*i/12)+.5;ctx.moveTo(x,0);ctx.lineTo(x,h)}
  for(let j=1;j<4;j++){const y=Math.round(h*j/4)+.5;ctx.moveTo(0,y);ctx.lineTo(w,y)}
  ctx.stroke();ctx.globalAlpha=1;
  if(wave.length<3)return;
  let mn=Infinity,mx=-Infinity;
  for(const v of wave){if(v<mn)mn=v;if(v>mx)mx=v}
  const span=(mx-mn)||1,n=wave.length,off=WAVE_N-n;
  const X=i=>(i+off)/(WAVE_N-1)*w,Y=v=>h*0.14+(1-(v-mn)/span)*h*0.72;
  ctx.beginPath();ctx.moveTo(X(0),Y(wave[0]));
  for(let m=1;m<n;m++)ctx.lineTo(X(m),Y(wave[m]));
  ctx.lineJoin='round';ctx.lineCap='round';ctx.strokeStyle=pulse;ctx.lineWidth=2.4;
  ctx.shadowColor=pulse;ctx.shadowBlur=12;ctx.stroke();ctx.shadowBlur=0;
  const first=waveN-n;
  ctx.fillStyle=pulse;
  beatMarks.forEach(mk=>{const i=mk-first;if(i<0||i>=n)return;ctx.globalAlpha=.9;ctx.beginPath();ctx.arc(X(i),Y(wave[i]),4,0,Math.PI*2);ctx.fill()});
  ctx.globalAlpha=1;
  const lx=X(n-1),ly=Y(wave[n-1]);
  ctx.globalAlpha=.25;ctx.beginPath();ctx.arc(lx,ly,9,0,Math.PI*2);ctx.fill();ctx.globalAlpha=1;
  ctx.beginPath();ctx.arc(lx,ly,3.5,0,Math.PI*2);ctx.fill();
}


 {id:'fingerpos',q:"Which finger should I use?",kw:['which finger','finger placement','how to place','place finger','too tight','how tight','pressure on sensor','finger position','index finger','middle finger'],
  p:["Use your index or middle finger and rest the fingertip pad lightly on the sensor window."],
  b:["Light, steady contact works best. Pressing hard cuts off blood flow.","Rest your hand on a table at heart level and keep still.","Use the same finger each time for comparable results."],rel:['coldhands','variation']},
 {id:'trouble',q:"The sensor is not detected. What should I do?",kw:['not detected','not found','port not showing','no port','driver','ch340','cp2102','com port','permission denied','sensor not working','zero reading','stuck','blank screen','not responding'],

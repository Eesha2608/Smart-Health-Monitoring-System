function restoreJournal(file){
  if(!file)return;
  const r=new FileReader();
  r.onload=()=>{
    try{
      const d=JSON.parse(r.result),list=Array.isArray(d)?d:d.entries;if(!Array.isArray(list))throw 0;
      const have=new Set(getJ().map(e=>e.id));let n=0;const j=getJ();
      list.forEach(e=>{if(e&&e.id&&e.t&&!isNaN(new Date(e.t))&&!have.has(e.id)){j.push({id:String(e.id),t:e.t,hr:+e.hr||null,spo2:+e.spo2||null,pi:e.pi==null?null:+e.pi,sq:e.sq==null?null:+e.sq,amp:e.amp==null?null:+e.amp,temp:e.temp==null?null:+e.temp,rmssd:e.rmssd==null?null:+e.rmssd,stress:e.stress==null?null:+e.stress,ready:e.ready==null?null:+e.ready,tags:Array.isArray(e.tags)?e.tags.map(String):[],sleep:e.sleep?String(e.sleep):'',note:e.note?String(e.note):'',sym:Array.isArray(e.sym)?e.sym.map(String):[]});have.add(String(e.id));n++}});
      j.sort((a,b)=>new Date(a.t)-new Date(b.t));putJ(j.slice(-365));renderJournal();jmsg(n+' reading'+(n===1?'':'s')+' restored.');
    }catch(e){jmsg('That file is not a PulseSpace backup.')}
  };
  r.readAsText(file);
}

function readingAnswer(raw){
  const q=raw.toLowerCase().replace(/₂/g,'2');let m;
  const num=x=>parseFloat(x);
  if(m=q.match(/(\d{2,3})\s*\/\s*(\d{2,3})/)){
    if(/\bbp\b|blood pressure|pressure/.test(q)){
      const s=+m[1],dd=+m[2];
      let t,adv;
      if(s>=180||dd>=120){t='very high';adv="This is in the range that needs urgent attention. If you also have chest pain, a bad headache, breathlessness, weakness or confusion, call emergency services. Otherwise rest for five minutes and measure again, then contact a doctor today."}
      else if(s>=140||dd>=90){t='high (stage 2 range)';adv="Repeat the reading after sitting quietly for five minutes. If it stays this high, see a doctor soon."}
      else if(s>=130||dd>=80){t='raised (stage 1 range)';adv="Cut salt, stay active and check again on other days. Talk to a doctor if it stays at this level."}
      else if(s>=120){t='slightly raised';adv="Lifestyle changes such as less salt, more activity and a healthy weight help."}
      else if(s<90||dd<60){t='low';adv="Low pressure is fine if you feel well. If you feel dizzy or faint, sit down, drink fluids and see a doctor."}
      else{t='in the normal range';adv="Keep up your healthy habits."}
      return {paras:["A blood pressure of "+s+"/"+dd+" mmHg is "+t+"."],after:adv+" PulseSpace cannot measure blood pressure, so use a proper arm cuff.",chips:[KBMAP.bp.q,KBMAP.salt.q]};
    }
  }
  if(m=q.match(/(?:spo2|oxygen|saturation)\D{0,15}?(\d{2,3})/)||q.match(/(\d{2,3})\s*%?\s*(?:spo2|oxygen)/)){
    const v=num(m[1]);
    if(v>=70&&v<=100){
      let t,adv;
      if(v>=95){t='in the normal range';adv="No action needed. Measure again if you feel unwell."}
      else if(v>=92){t='a little low';adv="Warm your hands, sit upright, breathe slowly and measure again. If it stays under 95%, speak to a doctor."}
      else{t='low';adv="Get medical help, especially with breathlessness, chest tightness, confusion or blue lips. Re-check after warming your hands, but do not wait if you feel unwell."}
      return {paras:["An SpO₂ of "+v+"% is "+t+"."],after:adv+" Finger sensors give an estimate, and cold fingers, movement or nail polish can lower it.",chips:[KBMAP.lowspo2.q,KBMAP.spoacc.q]};
    }
  }
  if(m=q.match(/(?:heart rate|pulse|bpm|\bhr\b)\D{0,15}?(\d{2,3})/)||q.match(/(\d{2,3})\s*bpm/)){
    const v=num(m[1]);
    if(v>=25&&v<=240){
      let t,adv;
      if(v<40){t='very low for a resting pulse';adv="If you are not an athlete, or you feel dizzy, faint or short of breath, see a doctor promptly."}
      else if(v<50){t='low at rest';adv="This can be normal for a fit person. See a doctor if you feel dizzy, tired or faint."}
      else if(v<=100){t='in the normal resting range (60 to 100)';adv="No action needed."}
      else if(v<=130){t='above the normal resting range';adv="That is expected during or just after activity. At rest, sit down, drink water, breathe slowly and re-check in five minutes. See a doctor if it stays above 100."}
      else{t='very high for rest';adv="If you have not just exercised, rest and re-check. A pulse this high at rest, or with chest pain, dizziness or breathlessness, needs medical help."}
      return {paras:["A heart rate of "+v+" bpm is "+t+"."],after:adv,chips:[KBMAP.rhr.q,KBMAP.tachy.q]};
    }
  }
  if(m=q.match(/(?:hrv|rmssd)\D{0,12}?(\d{1,3})/)){
    const v=num(m[1]);
    const t=v>=40?'a strong recovery value':v>=20?'moderate':'low';
    return {paras:["An RMSSD of "+v+" ms is "+t+" by PulseSpace's scale."],after:"HRV is very personal and falls with age, so compare it with your own average. A drop lasting several days points to stress, poor sleep or illness.",chips:[KBMAP.hrvgood.q,KBMAP.hrvmath.q]};
  }
  return null;
}


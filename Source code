const KBMAP={};
KB.forEach(e=>{KBMAP[e.id]=e;e._k=e.kw.map(words)});

function kbRank(q){
  const toks=words(q);if(!toks.length)return [];
  const out=[];
  const qs=' '+q.toLowerCase().replace(/₂/g,'2').replace(/[^a-z0-9\s]/g,' ').replace(/\s+/g,' ').trim()+' ';
  KB.forEach(e=>{
    let s=0;
    e.kw.forEach(k=>{if(k.length>5&&qs.includes(' '+k.toLowerCase().replace(/[^a-z0-9\s]/g,' ').replace(/\s+/g,' ').trim()+' '))s+=6+4*(k.trim().split(/\s+/).length-1)});
    e._k.forEach(ws=>{
      if(!ws.length)return;
      if(ws.length>1){if(ws.every(w=>toks.some(t=>near(t,w))))s+=4+2*ws.length}
      else{const w=ws[0];if(toks.includes(w))s+=2;else if(toks.some(t=>near(t,w)))s+=1.2}
    });
    if(s>0)out.push({e,score:s,i:KB.indexOf(e)});
  });
  return out.sort((a,b)=>(b.score-a.score)||(b.i-a.i));
}


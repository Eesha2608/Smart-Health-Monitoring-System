function regNote(P){
  const n=$('#reg-note');if(!P){n.textContent='';return}
  let s;
  if(P.cv<0.08&&P.pnn<35)s='Beat regularity: steady. Your beat gaps were even.';
  else if(P.cv<0.15)s='Beat regularity: some natural variation, which is common and usually healthy at rest.';
  else s='Beat regularity: your beat gaps varied a lot. Movement can cause this, so measure again while still. If you also feel palpitations or dizziness, see a doctor. This sensor cannot diagnose rhythm problems.';
  n.textContent=s;
}
function dayKey(d){const x=new Date(d);return x.getFullYear()+'-'+x.getMonth()+'-'+x.getDate()}
function renderBaseline(){
  const card=$('#baseCard');
  if(!result){card.hidden=true;return}
  const past=getJ().filter(e=>e.id!==result.savedId&&new Date(e.t)<result.time).slice(-14);
  if(past.length<3){card.hidden=true;return}
  const av=k=>{const v=past.map(e=>e[k]).filter(x=>x!=null);return v.length?mean(v):null};
  const rows=[['hr','Heart rate','bpm',result.hr],['rmssd','HRV','ms',result.rmssd],['ready','Readiness','',result.ready],['stress','Stress','',result.stress]];
  let html='',hrd=null,hvd=null;
  rows.forEach(([k,l,u,cur])=>{
    const a=av(k);if(a==null||cur==null)return;
    const d=Math.round(cur-a);
    if(k==='hr')hrd=d;if(k==='rmssd')hvd=d;
    html+='<div class="d"><b class="num">'+(d===0?'Same':(d>0?'+':'\u2212')+Math.abs(d)+(u?' '+u:''))+'</b><span>'+l+', usual '+Math.round(a)+(u?' '+u:'')+'</span></div>';
  });
  if(!html){card.hidden=true;return}
  $('#base-sub').textContent='Average of your last '+past.length+' saved readings.';
  $('#base').innerHTML=html;
  let t='Your numbers are close to your usual.';
  if(hrd!=null&&hvd!=null){
    if(hrd>=6&&hvd<=-8)t='Resting heart rate is up and HRV is down compared with your usual. That pattern often shows up with short sleep, stress, alcohol or the start of an illness. Go easy today.';
    else if(hrd<=-4&&hvd>=8)t='Heart rate is lower and HRV higher than usual. That points to good recovery today.';
    else if(hrd>=6)t='Your heart rate is higher than usual. Caffeine, dehydration or stress can do this.';
    else if(hvd<=-8)t='Your HRV is lower than usual, which can mean your body is under some strain.';
    else if(hvd>=8)t='Your HRV is higher than usual, a good sign of recovery.';
  }
  if(past.length>=10){
    const rng=k=>{const v=past.map(e=>e[k]).filter(x=>x!=null).sort((a,b)=>a-b);if(v.length<10)return null;return [v[Math.floor(v.length*0.1)],v[Math.ceil(v.length*0.9)-1]]};
    const hr=rng('hr'),hv=rng('rmssd'),bits=[];
    if(hr&&result.hr!=null)bits.push('Your usual resting heart rate is '+Math.round(hr[0])+' to '+Math.round(hr[1])+' bpm, and today\u2019s '+Math.round(result.hr)+' is '+(result.hr<hr[0]?'below':result.hr>hr[1]?'above':'inside')+' that range.');
    if(hv&&result.rmssd!=null)bits.push('Your usual HRV is '+Math.round(hv[0])+' to '+Math.round(hv[1])+' ms, and today\u2019s '+Math.round(result.rmssd)+' is '+(result.rmssd<hv[0]?'below':result.rmssd>hv[1]?'above':'inside')+' it.');

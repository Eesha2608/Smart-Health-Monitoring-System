    <input id="chat-input" type="text" placeholder="Type any health question" aria-label="Ask the coach" maxlength="200" autocomplete="off" enterkeyhint="send">
    <button type="button" class="send" id="chat-send" aria-label="Send"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7"/></svg></button>
  </div>
</aside>

<script>
(function(){
'use strict';
const $=(s,r)=>(r||document).querySelector(s);
const $$=(s,r)=>Array.from((r||document).querySelectorAll(s));
const clamp=(v,a,b)=>Math.min(b,Math.max(a,v));
const fmt=(v,d)=>v==null||Number.isNaN(v)?'--':Number(v).toFixed(d);
const median=a=>{const s=a.slice().sort((x,y)=>x-y),n=s.length;return n%2?s[(n-1)/2]:(s[n/2-1]+s[n/2])/2};
const mean=a=>a.reduce((x,y)=>x+y,0)/a.length;
const SVGNS='http://www.w3.org/2000/svg';
const svgEl=(n,a)=>{const e=document.createElementNS(SVGNS,n);for(const k in a)e.setAttribute(k,a[k]);return e};
const reduceMotion=()=>window.matchMedia&&matchMedia('(prefers-reduced-motion: reduce)').matches;

/* ---------- storage and preferences (this browser only; falls back to memory if blocked) ---------- */
const mem={};
const store={
  get(k){try{const v=localStorage.getItem(k);if(v!=null)return JSON.parse(v)}catch(e){}return mem[k]===undefined?null:mem[k]},
  set(k,v){mem[k]=v;try{localStorage.setItem(k,JSON.stringify(v));return true}catch(e){return false}}
};
const prefs=Object.assign({theme:null,sound:false},store.get('pulsespace.prefs.v1')||{});
const savePrefs=()=>store.set('pulsespace.prefs.v1',prefs);
const sysLight=()=>!!(window.matchMedia&&matchMedia('(prefers-color-scheme: light)').matches);
function applyTheme(){document.documentElement.dataset.theme=(prefs.theme?prefs.theme==='light':sysLight())?'light':'dark'}
applyTheme();

/* ---------- check-in questions ---------- */
const QUESTIONS=[
 {id:'unwell',t:'Do you feel unwell right now?',s:'For example a fever, unusual weakness or tiredness.',label:'Feeling unwell',urgent:false},
 {id:'chest',t:'Do you have chest pain, pressure or tightness?',s:'Any discomfort in the chest, even if it is mild.',label:'Chest discomfort',urgent:true},
 {id:'breath',t:'Are you short of breath, dizzy or lightheaded?',s:'This includes a feeling that you might faint.',label:'Breathlessness or dizziness',urgent:true},
 {id:'racing',t:'Is your heart racing, fluttering or skipping beats?',s:'You may notice it in your chest, neck or throat.',label:'Palpitations',urgent:false}
];
let qi=0,answers={},result=null,view='intake';

/* the progress line is a heartbeat trace that grows one beat per answer */
function buildEcg(){
  const N=QUESTIONS.length,W=400/N,k=W/100;let d='M0 28';
  for(let i=0;i<N;i++){
    const x=i*W,p=(a,b)=>' L'+(x+a*k).toFixed(1)+' '+b;
    d+=p(28,28)+p(34,22)+p(40,28)+p(50,28)+p(54,33)+p(60,4)+p(66,41)+p(72,28)+p(84,20)+p(96,28)+p(100,28);
  }
  const svg=$('#ecg-prog');svg.innerHTML='';
  svg.appendChild(svgEl('path',{d,class:'base',fill:'none','stroke-width':2,'stroke-linejoin':'round'}));
  svg.appendChild(svgEl('path',{d,class:'live',fill:'none','stroke-width':2.4,'stroke-linecap':'round','stroke-linejoin':'round',pathLength:100,style:'stroke-dasharray:100 100;stroke-dashoffset:100'}));
}

/* ---------- metric definitions ---------- */
const clsSq=v=>v==null?['none','No signal']:v>=80?['good','Good']:v>=50?['warn','Fair']:['crit','Poor'];
const clsHr=v=>v==null?['none','No signal']:(v<40||v>130)?['crit','Out of range']:v<50?['warn','Low']:v>100?['warn','Elevated']:['good','Normal'];
const clsStress=v=>v==null?['none','Not enough beats']:v<30?['good','Relaxed']:v<55?['good','Balanced']:v<75?['warn','Elevated']:['crit','High'];
const clsReady=v=>v==null?['none','Not enough beats']:v>=80?['good','Ready']:v>=60?['good','Steady']:v>=40?['warn','Take it easy']:['warn','Rest up'];
const METRICS=[
 {key:'spo2',label:'SpO₂',unit:'%',dec:0,hint:'Blood oxygen saturation. 95% and above is typical.',
  cls:v=>v==null?['none','No signal']:v>=95?['good','Normal']:v>=92?['warn','Low']:['crit','Very low']},
 {key:'pi',label:'Perfusion index',unit:'%',dec:1,hint:'Pulse strength compared with tissue. Higher means better blood flow at the finger.',
  cls:v=>v==null?['none','No signal']:v>=1.5?['good','Strong']:v>=0.5?['warn','Moderate']:['warn','Weak']},
 {key:'sq',label:'Signal quality',unit:'%',dec:0,hint:'How clean and steady the pulse signal was.',cls:clsSq},
 {key:'amp',label:'Pulse amplitude',unit:'counts',dec:0,hint:'Peak-to-peak height of each pulse wave from the sensor.',
  cls:v=>v==null?['none','No signal']:v>=1000?['good','Strong']:v>=400?['warn','Moderate']:['warn','Weak']},
 {key:'temp',label:'Sensor temperature',unit:'°C',dec:1,hint:'Temperature at the sensor chip, close to skin temperature.',
  cls:v=>v==null?['none','No signal']:v<28?['warn','Cool']:v<=37.5?['good','Normal']:v<=39?['warn','Warm']:['crit','Hot']},
 {key:'rmssd',label:'HRV · RMSSD',unit:'ms',dec:0,hint:'Beat-to-beat variation. Higher usually means better recovery.',
  cls:v=>v==null?['none','Not enough beats']:v>=40?['good','Strong recovery']:v>=20?['warn','Moderate']:['warn','Low']}
];
const M=k=>METRICS.find(m=>m.key===k);
/* eight vitals orbit the heart-rate dial, clockwise from the top */
const MOONS=[
 Object.assign({},M('spo2'),{short:'SpO₂',min:88,max:100,ask:'What is SpO2?'}),
 Object.assign({},M('rmssd'),{short:'HRV',min:0,max:80,ask:'What is HRV?'}),
 {key:'stress',label:'Stress score',short:'Stress',unit:'/100',dec:0,min:0,max:100,cls:clsStress,ask:'Why is my stress score this?',
  hint:'0 is calm and 100 is very strained. It blends low HRV (65%) and a fast pulse (35%).'},
 {key:'ready',label:'Readiness',short:'Readiness',unit:'/100',dec:0,min:0,max:100,cls:clsReady,ask:'What is the readiness score?',
  hint:'A wellness estimate of how recovered you look, from HRV recovery, resting heart rate and oxygen.'},
 Object.assign({},M('sq'),{short:'Signal',min:0,max:100,ask:'What is signal quality?'}),
 Object.assign({},M('pi'),{short:'Perfusion',min:0,max:5,ask:'What is perfusion index?'}),
 Object.assign({},M('amp'),{short:'Amplitude',min:0,max:3000,ask:'What is pulse amplitude?'}),
 Object.assign({},M('temp'),{short:'Sensor temp',min:25,max:40,ask:'What is sensor temperature?'})
];
let selKey='spo2';

/* ---------- helpers ---------- */
const setLevel=(el,pair)=>{el.dataset.level=pair[0];const t=el.querySelector('.pt');if(t)t.textContent=pair[1]};
function spark(svg,data){
  const w=svg.clientWidth||180,h=svg.clientHeight||36;
  svg.setAttribute('viewBox','0 0 '+w+' '+h);
  const d=data.filter(v=>v!=null);
  if(d.length<2){svg.innerHTML='';return}
  let mn=Math.min(...d),mx=Math.max(...d);
  if(mx-mn<1e-6){mn-=1;mx+=1}
  const pad=5;
  const pts=d.map((v,i)=>[pad+(i/(d.length-1))*(w-pad*2),pad+(1-(v-mn)/(mx-mn))*(h-pad*2)]);
  const line='M'+pts.map(p=>p[0].toFixed(1)+' '+p[1].toFixed(1)).join('L');
  const last=pts[pts.length-1];
  svg.innerHTML='<path d="'+line+'L'+last[0].toFixed(1)+' '+h+'L'+pts[0][0].toFixed(1)+' '+h+'Z" fill="var(--pulse)" fill-opacity=".1"/>'+
   '<path d="'+line+'" fill="none" stroke="var(--pulse)" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"/>'+
   '<circle cx="'+last[0].toFixed(1)+'" cy="'+last[1].toFixed(1)+'" r="3.5" fill="var(--pulse)"/>';
}

/* ---------- the dial: segment-display heart rate inside a ring of 60 ticks ---------- */
const SEGS={a:[12,2,36,9],g:[12,45.5,36,9],d:[12,89,36,9],f:[2,12,9,33],b:[49,12,9,33],e:[2,55,9,33],c:[49,55,9,33]};
const GLYPH={'0':'abcdef','1':'bc','2':'abdeg','3':'abcdg','4':'bcfg','5':'acdfg','6':'acdefg','7':'abc','8':'abcdefg','9':'abcdfg','-':'g',' ':''};
const slots=[],ticks=[];
function buildOrb(){
  const o=$('#orb');
  for(let i=0;i<60;i++){
    const a=i/60*2*Math.PI-Math.PI/2,r1=176,r2=i%5===0?195:188;
    const t=svgEl('line',{x1:(200+r1*Math.cos(a)).toFixed(2),y1:(200+r1*Math.sin(a)).toFixed(2),x2:(200+r2*Math.cos(a)).toFixed(2),y2:(200+r2*Math.sin(a)).toFixed(2),class:'tick'});
    o.appendChild(t);ticks.push(t);
  }
  o.appendChild(svgEl('circle',{cx:200,cy:200,r:164,class:'ring-bg'}));
  o.appendChild(svgEl('circle',{cx:200,cy:200,r:158,class:'core'}));
  const g=svgEl('g',{transform:'translate(75 118) scale(1.2) skewX(-5)'});
  for(let i=0;i<3;i++){
    const sg=svgEl('g',{transform:'translate('+(i*74)+' 0)'}),segs={};
    Object.keys(SEGS).forEach(k=>{const s=SEGS[k],r=svgEl('rect',{x:s[0],y:s[1],width:s[2],height:s[3],rx:4.5,class:'seg'});sg.appendChild(r);segs[k]=r});
    g.appendChild(sg);slots.push(segs);
  }
  o.appendChild(g);
}
function setDigits(n){
  const s=n==null?'---':String(Math.round(n)).padStart(3,' ');
  slots.forEach((segs,i)=>{const on=GLYPH[s[i]]||'';Object.keys(segs).forEach(k=>segs[k].classList.toggle('on',on.indexOf(k)>=0))});
  $('#orb').setAttribute('aria-label','Heart rate '+(n==null?'not available':Math.round(n)+' beats per minute'));
}
function setTicks(n){ticks.forEach((t,i)=>t.classList.toggle('on',i<n))}
function buildMoons(){
  const wrap=$('#moons'),links=$('#links');
  MOONS.forEach((m,i)=>{
    const ang=(-90+i*45)*Math.PI/180,R=40,x=50+R*Math.cos(ang),y=50+R*Math.sin(ang);
    const b=document.createElement('button');b.type='button';b.className='moon';b.dataset.key=m.key;b.dataset.level='none';b.setAttribute('aria-pressed',m.key===selKey?'true':'false');
    b.style.left=x.toFixed(2)+'%';b.style.top=y.toFixed(2)+'%';b.style.setProperty('--p','0');
    b.innerHTML='<span class="moon-in"><span class="moon-v num">--</span><span class="moon-l">'+m.short+'</span></span>';
    wrap.appendChild(b);m.el=b;
    const ln=svgEl('line',{x1:50,y1:50,x2:x.toFixed(2),y2:y.toFixed(2)});ln.dataset.level='none';links.appendChild(ln);m.ln=ln;
    const pick=()=>selectMoon(m.key);
    b.addEventListener('mouseenter',pick);b.addEventListener('focus',pick);b.addEventListener('click',pick);
  });
}
function selectMoon(key){
  selKey=key;
  MOONS.forEach(m=>m.el.setAttribute('aria-pressed',m.key===key?'true':'false'));
  updateDock();
}
function updateDock(){
  const m=MOONS.find(x=>x.key===selKey),d=shown.d,idle=shown.idle;
  const v=d[m.key],pair=idle?['none',idle===true?'Not connected':idle]:m.cls(v);
  $('#dock').dataset.level=pair[0];
  $('#dk-name').textContent=m.label;setLevel($('#dk-pill'),pair);
  $('#dk-val').textContent=fmt(v,m.dec);$('#dk-unit').textContent=m.unit;
  $('#dk-hint').textContent=m.hint;$('#dk-ask').dataset.ask=m.ask;
  spark($('#dk-spark'),(d.series&&d.series[m.key])||[]);
}

/* ---------- live data ---------- */
const TARGET=30,MIN_OK=12,WAVE_N=300;
let wave=[],waveN=0,beatMarks=[];
const live={ibis:[],beats:0,lastData:0};
const SERIES_KEYS=['hr','spo2','pi','sq','amp','temp','rmssd','stress','ready'];
const newSession=()=>{const series={};SERIES_KEYS.forEach(k=>{series[k]=[]});return {samples:[],rm:[],ibisAll:[],series}};
const emptyData=()=>{const d={hr:null,spo2:null,pi:null,sq:null,amp:null,temp:null,rmssd:null,parts:null,stress:null,ready:null,readyParts:null,beats:0};d.series=newSession().series;return d};
let session=newSession();
let shown={d:emptyData(),idle:true};
let lastReadout=null;
const pushWave=v=>{wave.push(v);waveN++;if(wave.length>WAVE_N)wave.shift();while(beatMarks.length&&beatMarks[0]<waveN-WAVE_N)beatMarks.shift()};

function rmssd(){
  const a=live.ibis.slice(-30);if(a.length<8)return null;
  const s=a.slice().sort((x,y)=>x-y),med=s[s.length>>1];
  const c=a.filter(x=>Math.abs(x-med)<=med*0.3);if(c.length<6)return null;
  let sum=0,n=0;for(let i=1;i<c.length;i++){const d=c[i]-c[i-1];sum+=d*d;n++}
  return Math.sqrt(sum/n);
}
function stressParts(hr,r){
  if(hr==null||r==null)return null;
  const rec=clamp((r-15)/55,0,1),load=clamp((hr-60)/50,0,1);
  return {rec,load,score:Math.round(100*(0.65*(1-rec)+0.35*load))};
}
/* readiness: a wellness estimate from HRV recovery (50%), resting heart rate (25%) and oxygen (25%) */
function readiness(hr,r,spo2){
  if(hr==null||r==null)return null;
  const rec=clamp((r-15)/55,0,1),hrS=hr<=70?1:clamp(1-(hr-70)/50,0,1),ox=spo2==null?null:clamp((spo2-90)/8,0,1);
  const score=ox==null?(rec*0.667+hrS*0.333):(rec*0.5+hrS*0.25+ox*0.25);
  return {score:Math.round(100*score),rec,hrS,ox};
}
/* Poincaré rhythm map: each beat gap against the next */
function poincare(ibis){
  if(!ibis||ibis.length<8)return null;
  const x=ibis.slice(0,-1),y=ibis.slice(1),d=y.map((v,i)=>v-x[i]);
  const sd=a=>{const m=mean(a);return Math.sqrt(a.reduce((s,v)=>s+(v-m)*(v-m),0)/(a.length-1))};
  const sdd=sd(d),sdnn=sd(ibis);
  const pnn=100*d.filter(v=>Math.abs(v)>50).length/d.length;
  return {x,y,sdnn,pnn,cv:sdnn/mean(ibis),sd1:Math.sqrt(0.5)*sdd,sd2:Math.sqrt(Math.max(0,2*sdnn*sdnn-0.5*sdd*sdd)),mean:mean(ibis)};
}
function cleanIbis(a){
  if(a.length<4)return a.slice();
  const med=median(a);return a.filter(x=>Math.abs(x-med)<=med*0.3);
}

/* ---------- views ---------- */
const VIEWS=['intake','review','measure','results','advice','journal'];
const STEP_OF={intake:1,review:1,measure:2,results:3,advice:3,journal:4};
function navMove(){
  const b=$('#nav button[aria-current="page"]'),ind=$('#nav-ind');
  if(!b){ind.style.width='0';return}
  ind.style.width=b.offsetWidth+'px';ind.style.transform='translateX('+b.offsetLeft+'px)';
}
function show(v){
  view=v;
  const stage=$('#stage');
  stage.hidden=!(v==='measure'||v==='results');
  if(v==='measure')$('#v-measure').insertBefore(stage,$('#v-measure .ribbon-card'));
  else if(v==='results')$('#v-results').insertBefore(stage,$('#trio'));
  VIEWS.forEach(n=>{$('#v-'+n).hidden=n!==v});
  const el=$('#v-'+v);el.classList.remove('enter');void el.offsetWidth;el.classList.add('enter');
  const cur=STEP_OF[v];
  $$('#nav button').forEach(b=>{if(+b.dataset.step===cur)b.setAttribute('aria-current','page');else b.removeAttribute('aria-current')});
  navMove();
  window.scrollTo(0,0);
}
function note(msg){['#note','#note2'].forEach(id=>{const n=$(id);if(!msg){n.hidden=true;return}n.textContent=msg;n.hidden=false})}

/* check-in */
function renderQ(){
  const q=QUESTIONS[qi];
  $('#q-count').textContent='Question '+(qi+1)+' of '+QUESTIONS.length;
  $('#q-title').textContent=q.t;$('#q-sub').textContent=q.s;
  $('#ecg-prog .live').style.strokeDashoffset=String(100-Math.min(100,qi/QUESTIONS.length*100+8));
  $$('.choice').forEach(b=>b.setAttribute('aria-pressed',answers[q.id]===(b.dataset.a==='yes')?'true':'false'));
  $('#q-back').hidden=qi===0;
}
function answerQ(yes){
  answers[QUESTIONS[qi].id]=yes;
  if(qi<QUESTIONS.length-1){qi++;renderQ()}
  else{$('#ecg-prog .live').style.strokeDashoffset='0';renderReview();show('review')}
}
function renderReview(){
  const yes=QUESTIONS.filter(q=>answers[q.id]);
  $('#rv-title').textContent=yes.length?'Thank you for telling us':'Good to hear you feel well';
  $('#rv-chips').innerHTML=yes.length
    ?yes.map(q=>'<span class="pill" data-level="warn"><i></i>'+q.label+'</span>').join('')
    :'<span class="pill" data-level="good"><i></i>No discomfort reported</span>';
  $('#rv-text').textContent=yes.length
    ?'We will still take your readings, then tell you whether you should see a doctor.'
    :'Next we will take your readings. Connect your sensor to begin.';
  $('#rv-urgent').hidden=!yes.some(q=>q.urgent);
  note('');
}

/* measuring */
function measureUI(connected){
  $('#btn-connect2').hidden=connected;$('#btn-back2').hidden=connected;
  $('#btn-stop').hidden=!connected;$('#btn-finish').hidden=!connected;
  $('#ring-eyebrow').textContent=connected?'Taking your readings':'Sensor not connected';
}
function resetMeasure(){
  wave=[];waveN=0;beatMarks=[];live.ibis=[];live.beats=0;live.lastData=0;session=newSession();
  setTicks(0);$('#btn-finish').disabled=true;
}
function startMeasure(){
  resetMeasure();measureUI(true);
  $('#m-title').textContent='Place your finger on the sensor';
  $('#m-sub').textContent='Rest a fingertip lightly on the sensor and keep your hand still.';
  setLevel($('#m-sig'),['none','No finger']);
  show('measure');renderReadout(emptyData());
}
function idleMeasure(){
  resetMeasure();measureUI(false);
  $('#m-title').textContent='Waiting for your sensor';
  $('#m-sub').textContent='Connect the sensor to begin. Your readings appear here as soon as it is connected.';
  setLevel($('#m-sig'),['none','Not connected']);
  show('measure');renderReadout(emptyData(),true);
}
function liveReadout(m,hr){
  const r=hr!=null?rmssd():null,sp=stressParts(hr,r),sp2=hr!=null&&m.spo2>0?m.spo2:null,rd=readiness(hr,r,sp2);
  const d={hr,spo2:sp2,pi:hr!=null?m.pi:null,sq:hr!=null?m.sq:null,amp:hr!=null?m.amp:null,
    temp:m.temp>0?m.temp:null,rmssd:r,parts:sp,stress:sp?sp.score:null,ready:rd?rd.score:null,readyParts:rd,beats:live.beats};
  const S=session.series;
  SERIES_KEYS.forEach(k=>{S[k].push(d[k]);if(S[k].length>60)S[k].shift()});
  d.series=S;renderReadout(d);
}
const recentHr=[];
function signalTip(m){
  recentHr.push(m.hr);if(recentHr.length>6)recentHr.shift();
  const mx=Math.max(...recentHr),mn=Math.min(...recentHr);
  if(recentHr.length>=4&&mx-mn>10)return '. Your pulse is jumping, so hold your hand still.';
  if(m.sq<65)return '. Signal is a bit noisy: press lighter and rest your hand on a table.';
  if(m.pi<0.5)return '. Blood flow is low: warm your fingertip or try another finger.';
  return '';
}
function onSummary(m){
  live.lastData=performance.now();
  if(calm.open){onCalmSummary(m);return}
  if(view!=='measure')return;
  const hr=m.hr>0?m.hr:null;
  setLevel($('#m-sig'),hr==null?['none','No finger']:clsSq(m.sq));
  const valid=hr!=null&&m.spo2>0&&m.sq>=40;
  if(valid){session.samples.push(m);session.rm.push(rmssd())}
  liveReadout(m,hr);
  const n=session.samples.length;
  setTicks(Math.round(clamp(n/TARGET,0,1)*60));
  let t,s;
  if(hr==null){t=n?'Finger lifted':'Place your finger on the sensor';s=n?'Put it back lightly to continue. Your progress is kept.':'Rest a fingertip lightly on the sensor and keep your hand still.'}
  else if(!valid){t='Signal is weak';s='Press a little more gently, keep still and shade the sensor from bright light.'}
  else{t='Hold still';s=Math.max(0,TARGET-n)+' seconds left'+signalTip(m)}
  $('#m-title').textContent=t;$('#m-sub').textContent=s;
  $('#btn-finish').disabled=n<MIN_OK;
  if(n>=TARGET)finishMeasure();
}
function finishMeasure(){
  if(view!=='measure')return;
  const S=session.samples;if(S.length<MIN_OK)return;
  const col=k=>S.map(s=>s[k]);
  const hr=median(col('hr')),r=rmssd(),spo2=median(col('spo2')),sp=stressParts(hr,r),rd=readiness(hr,r,spo2);
  const series={};SERIES_KEYS.forEach(k=>{series[k]=session.series[k].slice()});
  result={hr,spo2,pi:median(col('pi')),sq:mean(col('sq')),amp:median(col('amp')),temp:median(col('temp')),
    rmssd:r,parts:sp,stress:sp?sp.score:null,ready:rd?rd.score:null,readyParts:rd,
    ibis:cleanIbis(session.ibisAll),series,beats:live.beats,time:new Date(),answers:Object.assign({},answers),savedId:null,tags:[],noteText:''};
  resetSaveUI();
  show('results');renderResults();disconnectSerial();
  $('#coach-fab').classList.add('has-new');
}

/* ---------- results ---------- */
function renderResults(){
  const r=result;
  $('#res-time').textContent=r.time.toLocaleString(undefined,{weekday:'long',day:'numeric',month:'long',hour:'numeric',minute:'2-digit'});
  const yes=QUESTIONS.filter(q=>r.answers[q.id]);
  setLevel($('#res-sym'),yes.length?['warn','Discomfort reported']:['good','No discomfort reported']);
  renderReadout(r);setTicks(60);fillCards(r);renderCompare();renderBaseline();
  $('#btn-save').disabled=false;
}
function renderPreview(){
  $('#res-time').textContent='No readings yet';
  const yes=QUESTIONS.filter(q=>answers[q.id]);
  setLevel($('#res-sym'),yes.length?['warn','Discomfort reported']:['none','Not measured']);
  const e=emptyData();renderReadout(e,'Not measured');setTicks(0);fillCards(e);
  $('#cmpCard').hidden=true;$('#btn-save').disabled=true;
  $('#save-msg').textContent='Take a measurement to save it to your journal.';
}
function ring(arcId,numId,pillId,cardId,v,pair){

const PATTERNS={recovery:{name:'Recovery test',steps:[]},relax:{name:'Relax: in 4, out 6',steps:[['in',4],['out',6]]},box:{name:'Box: 4-4-4-4',steps:[['in',4],['hold',4],['out',4],['hold',4]]},sleep:{name:'Sleep: 4-7-8',steps:[['in',4],['hold',7],['out',8]]}};

 ["Rest, change your setup, stretch and use cold or warm packs.","See a doctor for numbness, weakness, swelling or pain over 2 weeks."],['numbness','backposture']);
E('feet',"How do I care for my feet?",['foot care','cracked heels','corns','bunion','ingrown toenail','swollen feet','foot odour','diabetic foot','foot ulcer','flat foot','shoes','heel spur'],
 ["Wash and dry between the toes, moisturise heels and wear shoes that fit."],
 ["People with diabetes should check their feet daily for cuts, blisters and colour change and see a doctor early.","Painful, red or pus-filled toes need care."],['heel','diabetes']);
E('sunlightmood',"Does sunlight and nature help health?",['sunlight','morning sun','fresh air','nature walk','outdoors','vitamin sun','green space','seasonal depression','winter blues'],
 ["Morning daylight sets your body clock, lifts mood and supports vitamin D."],
 ["Aim for 20 to 30 minutes outdoors daily.","Winter low mood improves with light, exercise and routine."],['vitd','gratitude']);

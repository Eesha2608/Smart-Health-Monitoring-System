let staleShown=false;
function frame(){
  if(view==='measure'){
    const stale=live.lastData&&performance.now()-live.lastData>4000;
    if(stale&&!staleShown){staleShown=true;$('#m-title').textContent='No data from the sensor';$('#m-sub').textContent='Check the cable and that the sketch is running.'}
    if(!stale)staleShown=false;
    drawWave();
    const g=Math.exp(-(performance.now()-beatT)/300);
    if(Math.abs(g-lastGlow)>0.02){lastGlow=g;document.documentElement.style.setProperty('--glow',g.toFixed(2))}
  }else if(lastGlow!==0){lastGlow=0;document.documentElement.style.setProperty('--glow','0')}
  requestAnimationFrame(frame);
}

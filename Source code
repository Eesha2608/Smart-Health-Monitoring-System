<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>PulseSpace</title>
</head>
<body>
<style>
/* PulseSpace "Lumen": the sensor reads you with red and infrared light, so the interface is lit the same way.
   One memorable object (the orbiting vitals dial); everything else stays quiet. System fonts only, no outside requests. */
@property --p{syntax:'<number>';inherits:false;initial-value:0}
:root{
  color-scheme:dark;
  --font-display:ui-rounded,"SF Pro Rounded","Nunito","Segoe UI Variable Display","Segoe UI",system-ui,sans-serif;
  --font-body:system-ui,-apple-system,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;
  --bg:#1A0B16;--bg2:#12060F;
  --surface:#251120;--surface-2:#301A2A;--line:#4B2C42;--ghost:rgba(255,230,236,.07);
  --fg:#F9EDF0;--muted:#C3A7B6;
  --pulse:#FF5C70;--ir:#BBA6FF;
  --good:#6FE0C0;--warn:#FFC26B;--crit:#FF8663;
  --glow:0;
}
:root[data-theme="light"]{
  color-scheme:light;
  --bg:#FBF0EC;--bg2:#F4E3DD;
  --surface:#FFFAF8;--surface-2:#F6E8E3;--line:#E6CFC8;--ghost:rgba(60,20,40,.07);
  --fg:#2B1221;--muted:#7C5D6E;
  --pulse:#D4234A;--ir:#6A4FD6;
  --good:#12785B;--warn:#8F5609;--crit:#B8381A;
}
*,*::before,*::after{box-sizing:border-box}
[hidden]{display:none!important}
html{background:var(--bg2)}
body{margin:0;color:var(--fg);font:16px/1.55 var(--font-body);-webkit-font-smoothing:antialiased;min-height:100vh;
  background:
   radial-gradient(1100px 760px at 50% 34%,color-mix(in srgb,var(--pulse) calc(7% + var(--glow)*20%),transparent),transparent 68%),
   linear-gradient(180deg,var(--bg),var(--bg2)) fixed}
h1,h2,h3,p,dl,dd,ul,ol{margin:0}
ul,ol{padding:0;list-style:none}
button{font:inherit;color:inherit}
:focus-visible{outline:2px solid var(--ir);outline-offset:3px}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
[data-level="good"]{--lv:var(--good)}
[data-level="warn"]{--lv:var(--warn)}
[data-level="crit"]{--lv:var(--crit)}
[data-level="info"]{--lv:var(--ir)}
[data-level="none"]{--lv:var(--muted)}

.shell{max-width:1120px;margin:0 auto;padding:18px 16px 72px;display:flex;flex-direction:column;gap:26px}

/* top bar */
.top{display:flex;align-items:center;justify-content:space-between;gap:12px 20px;flex-wrap:wrap}
.brand{display:flex;align-items:center;gap:10px}
.mark{width:34px;height:34px;color:var(--pulse)}
.wordmark{font:700 24px/1 var(--font-display);letter-spacing:-.02em}
.nav{position:relative;display:flex;gap:2px;padding:4px;border-radius:999px;background:var(--surface);border:1px solid var(--line)}
.nav-ind{position:absolute;top:4px;bottom:4px;left:0;width:0;border-radius:999px;background:var(--fg);transition:transform .35s cubic-bezier(.3,.8,.3,1),width .35s cubic-bezier(.3,.8,.3,1)}
.nav button{position:relative;z-index:1;border:0;background:none;cursor:pointer;padding:8px 16px;border-radius:999px;font:600 14px var(--font-body);color:var(--muted);transition:color .2s}
.nav button:hover{color:var(--fg)}
.nav button[aria-current="page"]{color:var(--bg)}
.tools{display:flex;gap:8px}
.icon-btn{width:40px;height:40px;border-radius:50%;border:1px solid var(--line);background:var(--surface);cursor:pointer;display:grid;place-items:center;color:var(--fg);flex:none;transition:border-color .2s,background .2s}
.icon-btn:hover{border-color:var(--muted)}
.icon-btn[aria-pressed="true"]{background:var(--pulse);border-color:var(--pulse);color:#fff}
.icon-btn svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.9;stroke-linecap:round;stroke-linejoin:round}

/* type */
.h-xl{font:700 clamp(34px,6vw,58px)/1.02 var(--font-display);letter-spacing:-.03em;text-wrap:balance}
.h-lg{font:650 clamp(24px,3.6vw,32px)/1.12 var(--font-display);letter-spacing:-.02em;text-wrap:balance}
.h-md{font:650 18px/1.25 var(--font-display);letter-spacing:-.01em}
.lede{color:var(--muted);font-size:17px;max-width:56ch}
.small{font-size:13.5px;color:var(--muted)}
.label{font:600 13px var(--font-body);color:var(--muted)}
.unit{font:500 13px var(--font-body);color:var(--muted)}
.num{font-variant-numeric:tabular-nums}
.pill{display:inline-flex;align-items:center;gap:6px;font:600 12.5px var(--font-body);padding:3px 11px 3px 9px;border-radius:999px;color:var(--lv,var(--muted));background:color-mix(in srgb,var(--lv,var(--muted)) 14%,transparent);white-space:nowrap}
.pill i{width:6px;height:6px;border-radius:50%;background:currentColor}

/* views and cards */
.view{display:flex;flex-direction:column;gap:22px}
.view.enter{animation:rise .5s cubic-bezier(.2,.8,.2,1) both}
@keyframes rise{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
.center{max-width:660px;width:100%;margin-inline:auto}
.card{background:color-mix(in srgb,var(--surface) 88%,transparent);border:1px solid var(--line);border-radius:26px;padding:24px;min-width:0;backdrop-filter:blur(8px)}
.card.flat{border-radius:18px;padding:18px}
.row{display:flex;gap:10px;flex-wrap:wrap;align-items:center}
.btn{border:1px solid var(--line);background:var(--surface);padding:12px 22px;border-radius:999px;cursor:pointer;font:600 15px var(--font-body);transition:border-color .2s,transform .15s,background .2s}
.btn:hover:not(:disabled){border-color:var(--muted)}
.btn:active:not(:disabled){transform:scale(.97)}
.btn.primary{background:var(--pulse);border-color:var(--pulse);color:#fff;box-shadow:0 6px 22px color-mix(in srgb,var(--pulse) 38%,transparent)}
.btn.primary:hover:not(:disabled){filter:brightness(1.08)}
.btn.quiet{background:none}
.btn:disabled{opacity:.4;cursor:not-allowed}
.link{border:0;background:none;padding:6px 0;cursor:pointer;color:var(--muted);font-size:14px;text-decoration:underline;text-underline-offset:3px}
.link:hover{color:var(--fg)}
.callout{padding:14px 16px;border-radius:16px;font-size:14.5px;background:color-mix(in srgb,var(--crit) 12%,var(--surface));border:1px solid color-mix(in srgb,var(--crit) 40%,transparent)}
.callout.soft{background:color-mix(in srgb,var(--warn) 12%,var(--surface));border-color:color-mix(in srgb,var(--warn) 40%,transparent)}

/* check-in: progress is a heartbeat trace that grows one beat per answer */
.intro{display:flex;flex-direction:column;gap:14px}
.ecg-prog{display:block;width:100%;height:auto}
.orb.dim .seg.on{fill:var(--muted);filter:none;opacity:.6}
.calm-sensor{margin-top:18px}
.ecg-prog .base{stroke:var(--line)}
.ecg-prog .live{stroke:var(--pulse);filter:drop-shadow(0 0 5px var(--pulse));transition:stroke-dashoffset .8s ease}
.q-card{display:flex;flex-direction:column;gap:14px}
.choices{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:6px}
.choice{min-height:72px;border:1px solid var(--line);background:var(--surface-2);border-radius:20px;cursor:pointer;font:650 20px var(--font-display);transition:border-color .2s,background .2s,transform .15s}
.choice:hover{border-color:var(--pulse)}
.choice:active{transform:scale(.98)}
.choice[aria-pressed="true"]{background:var(--pulse);border-color:var(--pulse);color:#fff}
.choice kbd{font:500 12px var(--font-body);opacity:.6;margin-left:8px}
.chips{display:flex;flex-wrap:wrap;gap:8px}
.how{display:flex;flex-direction:column;gap:8px;padding:16px 18px;border-radius:16px;background:var(--surface-2);border:1px solid var(--line);font-size:14.5px;color:var(--muted)}
.how b{color:var(--fg);font-weight:600}

/* measure + results: the orrery */
.stage-head{display:flex;justify-content:space-between;align-items:flex-end;gap:16px;flex-wrap:wrap}
.stage-head .small{margin-bottom:8px}
.orrery{position:relative;width:min(100%,780px);aspect-ratio:1;margin-inline:auto}
.orrery .links{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}
.orrery .links line{stroke:var(--lv,var(--line));stroke-opacity:.5;stroke-width:1;vector-effect:non-scaling-stroke;stroke-dasharray:2 5;transition:stroke .4s}
.orb-wrap{position:absolute;left:50%;top:50%;width:46%;aspect-ratio:1;transform:translate(-50%,-50%)}
.orb{width:100%;height:100%;display:block;overflow:visible}
.orb .ring-bg{fill:none;stroke:var(--line);stroke-width:1}
.orb .tick{stroke:var(--ghost);stroke-width:3;stroke-linecap:round;transition:stroke .3s}
.orb .tick.on{stroke:var(--pulse);filter:drop-shadow(0 0 4px var(--pulse))}
.orb .core{fill:color-mix(in srgb,var(--pulse) calc(5% + var(--glow)*16%),var(--surface))}
.orb .seg{fill:var(--ghost);transition:fill .25s}
.orb .seg.on{fill:var(--pulse);filter:drop-shadow(0 0 7px var(--pulse))}
.orb-meta{position:absolute;left:0;right:0;top:67%;display:flex;flex-direction:column;align-items:center;gap:5px}
.orb-meta .unit{font-size:14px}
.heart{width:20px;height:20px;fill:var(--pulse);transform-origin:center}
.heart.beat{animation:thump .34s ease-out}
@keyframes thump{0%{transform:scale(1)}35%{transform:scale(1.4)}100%{transform:scale(1)}}
.ripple{position:absolute;inset:0;border-radius:50%;border:2px solid var(--pulse);pointer-events:none}
.moon{position:absolute;width:15.5%;aspect-ratio:1;transform:translate(-50%,-50%);border:0;border-radius:50%;padding:0;cursor:pointer;background:color-mix(in srgb,var(--surface) 92%,transparent);display:grid;place-items:center;text-align:center;transition:transform .25s cubic-bezier(.3,.8,.3,1),box-shadow .25s}
.moon::before{content:"";position:absolute;inset:0;border-radius:50%;padding:4px;background:conic-gradient(var(--lv,var(--muted)) calc(var(--p)*360deg),var(--line) 0);-webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);-webkit-mask-composite:xor;mask:linear-gradient(#000 0 0) content-box exclude,linear-gradient(#000 0 0);transition:--p .7s ease}
.moon:hover,.moon[aria-pressed="true"]{transform:translate(-50%,-50%) scale(1.09);box-shadow:0 0 0 6px color-mix(in srgb,var(--lv,var(--muted)) 16%,transparent),0 14px 34px rgba(0,0,0,.28)}
.moon-in{display:flex;flex-direction:column;align-items:center;gap:1px;line-height:1.1}
.moon-v{font:700 clamp(17px,2.9vw,26px)/1 var(--font-display);font-variant-numeric:tabular-nums}
.moon-l{font:600 clamp(10px,1.4vw,12.5px)/1.15 var(--font-body);color:var(--muted);max-width:92%}
.dock{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,1fr);gap:18px 28px;align-items:center}
.dock-main{display:flex;flex-direction:column;gap:8px}
.dock-top{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.dock-val{display:flex;align-items:baseline;gap:8px}
.dock-val .num{font:700 44px/1 var(--font-display)}
.spark{display:block;width:100%;height:64px}
.ask-link{border:0;background:none;padding:2px 0;color:var(--ir);font:600 13px var(--font-body);cursor:pointer;align-self:flex-start;text-decoration:underline;text-underline-offset:3px}
.ribbon-card{padding:14px 14px 10px}
.ribbon-head{display:flex;justify-content:space-between;align-items:center;gap:8px;padding:0 6px 8px}
#wave{display:block;width:100%;height:150px;border-radius:14px}
.stage-ctl{display:flex;flex-direction:column;align-items:center;gap:14px;text-align:center}
.stage-ctl .h-lg{min-height:1.2em}

/* results extras */
.trio{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}
.ready-ring{position:relative;width:150px;aspect-ratio:1;margin:6px auto 4px}
.ready-ring svg{width:100%;height:100%}
.ready-ring .t{fill:none;stroke:var(--line);stroke-width:9}
.ready-ring .v{fill:none;stroke:var(--lv);stroke-width:9;stroke-linecap:round;stroke-dasharray:0 100;transition:stroke-dasharray .9s ease}
.ready-ring .c{position:absolute;inset:0;display:grid;place-content:center;justify-items:center}
.ready-ring .c b{font:700 44px/1 var(--font-display)}
.parts{display:flex;flex-direction:column;gap:10px;margin-top:10px}
.part-row{display:flex;justify-content:space-between;font-size:13.5px;color:var(--muted);margin-bottom:5px}
.part-row b{color:var(--fg);font-weight:650}
.meter{height:4px;border-radius:99px;background:var(--line);overflow:hidden}
.meter i{display:block;height:100%;width:0;background:var(--lv,var(--ir));transition:width .6s ease}
#poin{display:block;width:100%;height:190px}
.stat-row{display:flex;gap:22px;margin-top:8px}
.stat-row div{display:flex;flex-direction:column}
.stat-row b{font:700 22px var(--font-display)}
.cmp{display:flex;flex-wrap:wrap;gap:10px;margin-top:12px}
.cmp .d{padding:10px 14px;border-radius:14px;background:var(--surface-2);border:1px solid var(--line);display:flex;flex-direction:column;min-width:112px}
.cmp .d b{font:700 20px var(--font-display)}
.cmp .d span{font-size:12.5px;color:var(--muted)}
.tagbar{display:flex;flex-wrap:wrap;gap:8px;margin:10px 0 12px}
.tag{border:1px solid var(--line);background:var(--surface-2);border-radius:999px;padding:7px 14px;font:600 13.5px var(--font-body);cursor:pointer;transition:background .2s,border-color .2s}
.tag[aria-pressed="true"]{background:var(--ir);border-color:var(--ir);color:var(--bg2)}
textarea,.field{width:100%;border-radius:16px;border:1px solid var(--line);background:var(--surface-2);color:var(--fg);padding:12px 14px;font:16px var(--font-body);resize:vertical}
textarea{min-height:76px}
.next{display:flex;justify-content:space-between;align-items:center;gap:20px 32px;flex-wrap:wrap;padding:28px}
.next .txt{display:flex;flex-direction:column;gap:6px;max-width:44ch}

/* suggestions */
.doctor{display:flex;gap:20px;align-items:flex-start;padding:30px;background:color-mix(in srgb,var(--lv) 9%,var(--surface));border-color:color-mix(in srgb,var(--lv) 45%,var(--line))}
.dr-ico{width:46px;height:46px;border-radius:50%;background:var(--lv);display:grid;place-items:center;flex:none}
.dr-ico svg{width:22px;height:22px;stroke:var(--bg2);fill:none;stroke-width:2.4;stroke-linecap:round}
.doctor .body{display:flex;flex-direction:column;gap:10px;min-width:0}
.doctor p{color:var(--muted)}
.why{display:flex;flex-direction:column;gap:6px;font-size:14.5px;margin-top:4px}
.why li{display:flex;gap:10px;align-items:baseline}
.why li::before{content:"";width:5px;height:5px;border-radius:50%;background:var(--lv);flex:none;transform:translateY(-2px)}
.tips li{display:flex;gap:14px;padding-block:16px;border-top:1px solid var(--line)}
.tips li:first-child{border-top:0;padding-top:4px}
.tips .dot{width:9px;height:9px;border-radius:50%;background:var(--lv);margin-top:8px;flex:none}
.tips h3{font:650 16px var(--font-body)}
.tips p{font-size:14.5px;color:var(--muted);margin-top:2px}
.calm-card{display:flex;align-items:center;gap:20px;flex-wrap:wrap;justify-content:space-between}

/* journal */
.sum{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}
.sum .card{padding:16px 18px}
.sum b{display:block;font:700 30px/1.1 var(--font-display);margin-top:4px}
.chart-top{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:10px}
.metric-pick{display:flex;flex-wrap:wrap;gap:6px}
.metric-pick button{border:1px solid var(--line);background:var(--surface-2);border-radius:999px;padding:6px 14px;font:600 13px var(--font-body);cursor:pointer}
.metric-pick button[aria-pressed="true"]{background:var(--fg);color:var(--bg);border-color:var(--fg)}
.chart-wrap{position:relative}
#trend{display:block;width:100%;height:240px}
.tip{position:absolute;pointer-events:none;padding:8px 12px;border-radius:12px;background:var(--fg);color:var(--bg);font:600 13px/1.35 var(--font-body);transform:translate(-50%,-110%);white-space:nowrap}
.entries{display:flex;flex-direction:column}
.entry{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,2fr) auto;gap:8px 18px;align-items:center;padding:14px 4px;border-top:1px solid var(--line)}
.entry:first-child{border-top:0}
.entry .when{font-weight:650}
.entry .vals{display:flex;gap:8px 16px;flex-wrap:wrap;font-size:14px;color:var(--muted)}
.entry .vals b{color:var(--fg);font-weight:650}
.entry .meta{grid-column:1/-1;font-size:13.5px;color:var(--muted)}
.empty{display:flex;flex-direction:column;align-items:flex-start;gap:12px;padding:34px}

/* calm session */
.calm{position:fixed;inset:0;z-index:60;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:22px;padding:24px;text-align:center;background:radial-gradient(900px 700px at 50% 45%,color-mix(in srgb,var(--ir) 20%,var(--bg)),var(--bg2))}
.calm-x{position:absolute;top:16px;right:16px}
.calm-set{display:flex;flex-direction:column;gap:16px;align-items:center;max-width:520px}
.seg-pick{display:flex;flex-wrap:wrap;justify-content:center;gap:8px}
.seg-pick button{border:1px solid var(--line);background:var(--surface);border-radius:999px;padding:9px 18px;font:600 14px var(--font-body);cursor:pointer}
.seg-pick button[aria-pressed="true"]{background:var(--ir);border-color:var(--ir);color:var(--bg2)}
.calm-orb{position:relative;width:min(62vw,340px);aspect-ratio:1;display:grid;place-items:center}
.calm-orb i{position:absolute;inset:0;border-radius:50%;background:radial-gradient(circle at 40% 35%,color-mix(in srgb,var(--ir) 70%,#fff),var(--ir) 55%,color-mix(in srgb,var(--ir) 40%,var(--bg2)));box-shadow:0 0 90px color-mix(in srgb,var(--ir) 55%,transparent);transform:scale(.55);will-change:transform}
.calm-orb b{position:relative;font:650 clamp(22px,4vw,30px) var(--font-display);color:var(--bg2);mix-blend-mode:normal}
.calm-hr{color:var(--muted);font-size:15px;min-height:1.4em}

/* coach */
.coach-fab{position:fixed;right:20px;bottom:calc(20px + env(safe-area-inset-bottom,0px));z-index:30;display:flex;align-items:center;gap:10px;padding:14px 22px;border:0;border-radius:999px;background:var(--fg);color:var(--bg);font:650 15px var(--font-body);cursor:pointer;box-shadow:0 12px 34px rgba(0,0,0,.35)}
.coach-fab svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linejoin:round}
.coach-fab.has-new::after{content:"";width:9px;height:9px;border-radius:50%;background:var(--pulse)}
.scrim{position:fixed;inset:0;z-index:35;background:rgba(10,3,8,.5)}
.coach{position:fixed;top:0;right:0;bottom:0;z-index:40;width:min(440px,100%);background:var(--surface);border-left:1px solid var(--line);display:flex;flex-direction:column;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);transform:translateX(100%);visibility:hidden;transition:transform .3s ease,visibility 0s .3s}
.coach.open{transform:none;visibility:visible;transition:transform .3s ease,visibility 0s}
.coach-head{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;padding:20px 20px 16px;border-bottom:1px solid var(--line)}
.coach-head h2{font:700 24px/1.1 var(--font-display)}
.coach-head p{font-size:13px;color:var(--muted);margin-top:4px}
.chat-log{flex:1;min-height:0;overflow-y:auto;padding:20px;display:flex;flex-direction:column;gap:12px}
.msg{max-width:90%;padding:12px 14px;border-radius:18px;font-size:14.5px;line-height:1.5;overflow-wrap:anywhere}
.msg.bot{background:var(--surface-2);border:1px solid var(--line);border-bottom-left-radius:5px;align-self:flex-start}
.msg.me{background:var(--pulse);color:#fff;border-bottom-right-radius:5px;align-self:flex-end}
.msg p+p,.msg p+ul,.msg ul+p{margin-top:8px}
.msg ul{padding-left:18px;list-style:disc;display:flex;flex-direction:column;gap:4px}
.typing{display:flex;gap:4px;padding:15px 16px;width:fit-content}
.typing i{width:6px;height:6px;border-radius:50%;background:var(--muted);animation:dots 1s infinite}
.typing i:nth-child(2){animation-delay:.15s}
.typing i:nth-child(3){animation-delay:.3s}
@keyframes dots{0%,80%,100%{opacity:.25}40%{opacity:1}}
.follow{display:flex;flex-wrap:wrap;gap:8px;align-self:flex-start}
.fu{border:1px solid var(--line);background:var(--surface);border-radius:999px;padding:7px 13px;font-size:13.5px;cursor:pointer;transition:border-color .2s}
.fu:hover{border-color:var(--ir)}
.chat-form{display:flex;gap:8px;padding:14px 16px;border-top:1px solid var(--line)}
.chat-form input{flex:1;min-width:0;padding:12px 16px;border-radius:999px;border:1px solid var(--line);background:var(--surface-2);color:var(--fg);font:16px var(--font-body)}
.chat-form input::placeholder{color:var(--muted)}
.send{width:46px;height:46px;border-radius:50%;border:0;background:var(--pulse);color:#fff;cursor:pointer;display:grid;place-items:center;flex:none}
.send svg{width:18px;height:18px;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;fill:none}

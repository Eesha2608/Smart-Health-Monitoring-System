E("nhrsleep","Why is my heart rate lower when I sleep?",["sleeping heart rate", "heart rate while sleeping", "pulse during sleep", "lower pulse at night", "why is my heart rate lower when i sleep"],["Heart rate normally falls 10 to 30 percent during sleep as the body rests, and is lowest in deep sleep."],["A resting rate of 45 to 60 asleep is common in fit people.", "Check with a doctor if you also have dizziness or fainting."],[]);
E("nhrstanding","Why does my pulse rise when I stand up?",["pulse rises standing", "heart rate on standing", "pulse when i stand", "standing heart rate jump", "why does my pulse rise when i stand up"],["Standing pools blood in the legs, so the heart speeds up by about 10 to 20 beats to keep blood pressure steady."],["A rise over 30 beats with dizziness may be POTS or dehydration.", "Drink water and stand up slowly."],[]);
E("nhrskipped","What are skipped heartbeats?",["skipped heartbeat", "skipped beats", "missed beat", "heart skips", "extra heartbeat", "ectopic beats", "pvc", "pac", "what are skipped heartbeats"],["Extra or early beats feel like a skip or flutter. They are common and usually harmless, often linked to caffeine, stress, or poor sleep."],["See a doctor if they are frequent, come with chest pain, breathlessness or fainting.", "A sensor may show odd gaps during a skip."],[]);
E("nhrflutter","Why does my heart flutter?",["heart flutter", "fluttering in chest", "butterflies in chest", "heart fluttering", "chest fluttering", "why does my heart flutter"],["Flutters are often from caffeine, anxiety, dehydration, lack of sleep or hormones. Most are harmless."],["Cut caffeine and rest for a few days.", "Get checked if fluttering lasts minutes, repeats often, or comes with dizziness or chest pain."],[]);
E("nhrnight","Why does my heart race at night?",["heart racing at night", "pounding heart in bed", "palpitations at night", "heart beats fast lying down", "night palpitations", "why does my heart race at night"],["At night you notice sensations more. Late caffeine, alcohol, heavy meals, stress or sleep apnea can all cause a racing or pounding pulse."],["Avoid alcohol and big dinners.", "Slow breathing helps. See a doctor if it keeps happening."],[]);
E("nhrexcite","Does excitement raise heart rate?",["excitement heart rate", "nervous heart rate", "adrenaline", "fight or flight", "heart rate emotions", "heart rate when scared", "does excitement raise heart rate"],["Yes. Excitement, fear and anger release adrenaline, which speeds the heart and tightens vessels. It settles in minutes."],["Breathe out slowly to bring it down.", "Measure after resting 5 minutes."],[]);
E("nhrage","Does resting heart rate change with age?",["heart rate older people", "pulse in old age", "elderly pulse", "resting heart rate by age", "senior heart rate", "does resting heart rate change with age"],["Resting rate changes little with age, but maximum heart rate falls about one beat per year. Elderly people may have slower pulses from medicines or conduction changes."],["60 to 100 is still the usual adult range.", "Slow pulse with dizziness needs review."],[]);
E("nhrwomen","Do women have a higher heart rate than men?",["women heart rate", "female pulse", "men vs women heart rate", "gender heart rate", "do women have a higher heart rate than men"],["On average women have resting rates a few beats higher than men, and rates shift with the menstrual cycle and pregnancy."],["Rates rise slightly before a period.", "Compare with your own baseline."],[]);
E("nhrcycle","Does my cycle change my pulse and HRV?",["cycle heart rate", "period pulse", "luteal phase heart rate", "hrv menstrual cycle", "ovulation heart rate", "does my cycle change my pulse and hrv"],["Resting heart rate is often a few beats higher and HRV lower in the second half of the cycle, because progesterone rises."],["Track on the same days each cycle.", "Do not read it as illness unless you feel unwell."],[]);
E("nhrfever","How much does fever raise pulse?",["fever raises pulse", "pulse with fever", "heart rate with temperature", "each degree heart rate", "how much does fever raise pulse"],["Pulse rises about 8 to 10 beats per minute for every degree Celsius of fever."],["A very fast pulse with high fever needs medical care.", "Rest and drink fluids."],[]);
E("nhrdehyd","Does dehydration raise heart rate?",["dehydration pulse", "dehydrated heart rate", "low water pulse", "thirsty fast heart", "does dehydration raise heart rate"],["Yes. Less fluid means less blood volume, so the heart beats faster to keep circulation steady."],["Drink water slowly and measure again.", "Urine color is a handy check."],[]);
E("nhrcaffeine","How long does caffeine raise my pulse?",["caffeine pulse duration", "coffee heart rate how long", "energy drink heart rate", "caffeine half life", "how long does caffeine raise my pulse"],["Caffeine peaks in 30 to 60 minutes and lasts 4 to 6 hours. Energy drinks can spike pulse more."],["Measure before coffee for a true baseline.", "Limit to 1 to 3 cups, none after noon."],[]);
E("nhrnicotine","Does nicotine or vaping raise heart rate?",["vaping heart rate", "nicotine pulse", "cigarette heart rate", "vape palpitations", "does nicotine or vaping raise heart rate"],["Nicotine raises heart rate and blood pressure within minutes, whether smoked or vaped."],["Quitting lowers resting heart rate within weeks.", "Ask a doctor about quit aids."],[]);
E("nhrmeds","Which medicines slow or speed the pulse?",["beta blocker pulse", "medicine lowers heart rate", "asthma inhaler heart rate", "decongestant heart racing", "thyroid tablets pulse", "antihistamine heart rate", "which medicines slow or speed the pulse"],["Beta blockers slow the pulse. Inhalers, decongestants, thyroid tablets and some cold medicines can speed it."],["Never stop a prescribed medicine on your own.", "Ask the pharmacist about side effects."],[]);
E("nhrhr","What is heart rate variability in simple words?",["what is hrv", "explain hrv", "hrv meaning", "heart rate variability simple", "what is heart rate variability in simple words"],["HRV is the small difference in time between beats. A healthy heart has slightly uneven gaps, which shows a flexible nervous system."],["Higher HRV usually means better recovery.", "Compare only against your own numbers."],[]);
E("nhrvlow","Why is my HRV low today?",["low hrv today", "hrv dropped", "hrv lower than usual", "hrv down", "why hrv decreased", "why is my hrv low today"],["Low HRV can follow poor sleep, alcohol, illness, stress, hard training, dehydration or measuring in a hurry."],["Rest and sleep, then retest at the same time.", "Look at the trend, not one reading."],[]);
E("nhrvhigh","Is a very high HRV a problem?",["high hrv bad", "hrv too high", "very high hrv", "hrv spike", "is a very high hrv a problem"],["Usually high HRV is good. Extremely high or erratic values can come from irregular rhythms or poor signal, so check the quality score."],["Re-measure with a still hand.", "See a doctor if you feel palpitations."],[]);
E("nhrvwhen","When is the best time to measure HRV?",["best time hrv", "when to measure hrv", "morning hrv", "hrv timing", "when is the best time to measure hrv"],["Measure at the same time daily, ideally after waking, seated and calm, before coffee."],["Stay still for 60 seconds or more.", "Use the same finger and posture."],[]);
E("nhrvalcohol","How does alcohol affect HRV?",["alcohol hrv", "drinking hrv", "hangover hrv", "wine heart rate", "beer pulse", "how does alcohol affect hrv"],["Alcohol raises resting heart rate and lowers HRV for hours, even after one or two drinks, and disrupts sleep."],["Expect recovery in a day or two.", "Skip alcohol before key readings."],[]);
E("nhrvexercise","How does exercise change HRV?",["exercise hrv", "workout hrv", "training hrv", "overtraining hrv", "hrv after run", "how does exercise change hrv"],["Regular training raises HRV over weeks. A hard session lowers it for 24 to 48 hours. A falling trend with a rising resting pulse suggests overtraining."],["Add rest days.", "Light sessions on low-HRV days."],[]);
E("nhrvage","Does HRV drop with age?",["hrv age", "hrv older", "hrv decline", "age hrv normal", "does hrv drop with age"],["Yes. HRV falls gradually with age, so compare yourself with your own past rather than others."],["Exercise and sleep slow the decline.", "RMSSD of 20 to 50 is common in middle age."],[]);
E("nhrvnormal","What is a normal RMSSD?",["normal rmssd", "good rmssd", "rmssd range", "rmssd average", "rmssd 30", "what is a normal rmssd"],["RMSSD varies a lot by person: many healthy adults sit between 20 and 80 ms. Your own average is the useful benchmark."],["Younger and fitter people tend to be higher.", "Watch trends over weeks."],[]);
E("nhrvshort","Can I measure HRV in 30 seconds?",["short hrv", "30 second hrv", "quick hrv", "hrv one minute", "hrv how long", "can i measure hrv in 30 seconds"],["Short readings are rough. One to two minutes is better and five minutes is the research standard."],["Stay still and breathe normally.", "Use the same duration each time."],[]);
E("nhrvbreath","Does breathing change my HRV?",["breathing hrv", "slow breathing hrv", "resonance breathing", "coherent breathing", "breath rate hrv", "does breathing change my hrv"],["Slow breathing around 6 breaths a minute increases HRV and calms the nervous system. Fast shallow breathing lowers it."],["Use the Calm session pattern.", "Breathe in 4, out 6."],[]);
E("nrsa","What is respiratory sinus arrhythmia?",["respiratory sinus arrhythmia", "rsa", "heart rate speeds on inhale", "breathing pulse link", "what is respiratory sinus arrhythmia"],["Heart rate naturally rises when you breathe in and falls when you breathe out. It is a sign of a healthy nervous system."],["It is why HRV changes with breathing rate."],[]);
E("nsympa","What are sympathetic and parasympathetic nerves?",["sympathetic nervous system", "parasympathetic", "vagus nerve", "rest and digest", "autonomic nervous system", "what are sympathetic and parasympathetic nerves"],["The sympathetic system speeds the body up for action. The parasympathetic, mainly the vagus nerve, slows the heart and restores calm. HRV reflects their balance."],["Slow exhales activate the vagus nerve.", "Sleep and rest strengthen it."],[]);

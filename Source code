  }
  if(!calm.open&&!$('#coach').classList.contains('open')&&!e.metaKey&&!e.ctrlKey&&!e.altKey&&/^[1-4]$/.test(e.key)&&!/INPUT|TEXTAREA|SELECT/.test((document.activeElement||{}).tagName||'')&&view!=='intake'){goStep(+e.key);return}
  if(view==='intake'&&!calm.open&&!$('#coach').classList.contains('open')&&!e.metaKey&&!e.ctrlKey&&!e.altKey&&!/INPUT|TEXTAREA|SELECT/.test((document.activeElement||{}).tagName||'')){
    if(e.key==='y'||e.key==='Y')answerQ(true);
    else if(e.key==='n'||e.key==='N')answerQ(false);
  }
});
